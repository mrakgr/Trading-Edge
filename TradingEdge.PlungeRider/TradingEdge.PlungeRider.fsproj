<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- PlungeRider: the SHORT-side mirror of SurgeRider (1-second-bar intraday
       momentum sampler, mc=0). Fork of TradingEdge.SurgeRider (2026-07-25):
       entry = channel-LOW breakdown (vwap < prior N-bar MIN), stop = the
       opposite channel side (vwap > prior N-bar MAX), P&L sign flipped
       (qty*(entry-exit); ret_exit = 1 - exit/entry), breach counters track
       LOW-side breaches (breach_sess = 0 -> AT THE SESSION LOW), the leg pair
       resets on new 20m HIGHS (bars_since_high_1200), and the aux profit-take
       marks record the first new {2,5,10,20}m LOWS after entry (aux_lo_*).
       Direction-neutral features (z grid, vol block, signed eff, gaps, VWAP
       distance) are IDENTICAL to SurgeRider — post-hoc SQL ports directly. -->
  <ItemGroup>
    <Compile Include="Intraday.fs" />
    <Compile Include="Backtest.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TradingEdge.RollingMa/TradingEdge.RollingMa.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.4.4" />
    <PackageReference Include="Nito.Collections.Deque" Version="1.2.1" />
  </ItemGroup>

</Project>
