<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Breakout: 1-SECOND-bar CONSOLIDATION BREAKOUTS on every futures root (user 2026-11-02) — trend following out of a
       tight (volume-weighted σ under a tick threshold), high-volume window with a floating left edge. PitFader's bars,
       session and contract; its sealed feature blocks are compiled in from TradingEdge.PitFader (linked sources). -->
  <ItemGroup>
    <Compile Include="../TradingEdge.PitFader/Types.fs" Link="PitFader/Types.fs" />
    <Compile Include="../TradingEdge.PitFader/Features.fs" Link="PitFader/Features.fs" />
    <Compile Include="../TradingEdge.PitFader/Leg.fs" Link="PitFader/Leg.fs" />
    <Compile Include="Engine.fs" />
    <Compile Include="VolEngine.fs" />
    <Compile Include="AbsEngine.fs" />
    <Compile Include="MomEngine.fs" />
    <Compile Include="LevelEngine.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TradingEdge.RollingMa/TradingEdge.RollingMa.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.4.4" />
    <PackageReference Include="Nito.Collections.Deque" Version="1.2.1" />
  </ItemGroup>

</Project>
